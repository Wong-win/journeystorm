---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const siteTitle = title ? `${title} — JourneyStorm` : "JourneyStorm — Guides de Voyage & Inspiration";
const desc = description || "Découvrez le monde avec JourneyStorm. Guides de voyage, conseils et inspiration pour votre prochaine aventure à travers l'Afrique, l'Amérique, l'Asie et l'Europe.";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="canonical" href={new URL(Astro.url.pathname, `https://www.journeystorm.com`)} />
    <title>{siteTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
      
    
      <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0T4J31F1E2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0T4J31F1E2');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo-link"><span class="logo-text">Journey<span class="logo-accent">Storm</span></span></a>
        <nav class="main-nav">
          <a href="/" class="nav-link">Accueil</a>
          <a href="/category/destinations/" class="nav-link">Destinations</a>
          <a href="/category/europe/" class="nav-link">Europe</a>
          <a href="/category/america/" class="nav-link">Amérique</a>
          <a href="/category/asia/" class="nav-link">Asie</a>
          <a href="/category/africa/" class="nav-link">Afrique</a>
          <a href="/category/travel-tips/" class="nav-link">Conseils</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-links">
          <a href="/about/">À propos</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy-policy/">Politique de confidentialité</a>
        </div>
        <p class="footer-copy">&copy; 2026 JourneyStorm. Tous droits réservés.</p>
        <p class="footer-copy">Photos via <a href="https://www.pexels.com/" rel="nofollow noopener" target="_blank">Pexels</a></p>
      </div>
    </footer>
  </body>
</html>
