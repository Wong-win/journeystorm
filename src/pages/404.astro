---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page Not Found (404)" description="The page you're looking for doesn't exist.">
  <div class="error-page">
    <h1>404</h1>
    <p class="error-message">Page not found</p>
    <p>Sorry, the page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="error-home-link">← Back to home</a>
  </div>
</Layout>

<style>
  .error-page {
    max-width: 560px;
    margin: 80px auto;
    text-align: center;
    padding: 0 24px;
    font-family: var(--font-body, system-ui, -apple-system, sans-serif);
    color: var(--color-text, #1a1a1a);
  }
  .error-page h1 {
    font-size: 96px;
    margin: 0 0 8px;
    font-weight: 800;
    letter-spacing: -2px;
  }
  .error-message {
    font-size: 24px;
    margin: 0 0 24px;
    font-weight: 600;
  }
  .error-page p {
    margin: 0 0 32px;
    opacity: 0.7;
  }
  .error-home-link {
    display: inline-block;
    padding: 14px 28px;
    background: var(--color-accent, #111);
    color: #fff;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: opacity 0.2s;
  }
  .error-home-link:hover {
    opacity: 0.85;
  }
</style>
