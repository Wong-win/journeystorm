---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page introuvable (404)" description="La page que vous cherchez n'existe pas ou a été déplacée.">
  <div class="error-page">
    <h1>404</h1>
    <p class="error-message">Page introuvable</p>
    <p>Désolé, la page que vous cherchez n'existe pas ou a été déplacée.</p>
    <a href="/" class="error-home-link">← Retour à l'accueil</a>
  </div>
</Layout>

<style>
  .error-page {
    max-width: 560px;
    margin: 80px auto;
    text-align: center;
    padding: 0 24px;
    font-family: var(--font-sans);
    color: var(--text);
  }
  .error-page h1 {
    font-size: 96px;
    line-height: 1;
    margin: 0 0 8px;
    font-weight: 800;
    letter-spacing: -2px;
    font-family: var(--font-serif);
  }
  .error-message {
    font-size: 24px;
    margin: 0 0 24px;
    font-weight: 600;
  }
  .error-page p {
    font-size: 0.95rem;
    margin: 0 0 32px;
    color: var(--muted);
  }
  .error-home-link {
    display: inline-block;
    padding: 14px 28px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .error-home-link:hover {
    background: var(--accent-dark);
  }
</style>
