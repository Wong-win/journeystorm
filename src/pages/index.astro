---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const pageSlugs = ["about", "contact", "privacy-policy", "home"];

const allArticles = (await getCollection("articles"))
  .filter((a) => !pageSlugs.includes(a.data.postSlug))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const hero = allArticles[0];
const grid = allArticles.slice(1);
---

<Layout title="Accueil" description="Découvrez le monde avec JourneyStorm — guides de voyage, conseils et inspiration pour vos prochaines aventures en Afrique, Amérique, Asie et Europe.">
  <!-- HERO -->
  {hero && (
    <section class="home-section">
      <div class="hero-card">
        {hero.data.image && <img src={hero.data.image} alt={hero.data.title} />}
        <div class="hero-overlay">
          <div class="card-category">
            {hero.data.categories.map((cat: string, i: number) => (
              <a href={`/category/${hero.data.categorySlugs[i] || cat}/`} style="color:#fff;text-decoration:none;">{cat}{i < hero.data.categories.length - 1 && " · "}</a>
            ))}
          </div>
          <h2 style="margin:8px 0;font-size:1.8rem">
            <a href={`/${hero.data.postSlug}/`} style="color:#fff;text-decoration:none;">{hero.data.title}</a>
          </h2>
          <div class="card-meta" style="color:rgba(255,255,255,0.8)">
            {new Date(hero.data.date).toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 3-COLUMN GRID -->
  <section class="home-section">
    <div class="three-col-grid">
      {grid.map((a) => (
        <article class="card">
          {a.data.image && (
            <a href={`/${a.data.postSlug}/`} class="card-img-link">
              <img src={a.data.image} alt={a.data.title} class="card-image" loading="lazy" />
            </a>
          )}
          <div class="card-body">
            <div class="card-category">
              {a.data.categories.slice(0, 2).map((cat: string, i: number) => (
                <a href={`/category/${a.data.categorySlugs[i] || cat}/`}>{cat}{i < Math.min(a.data.categories.length, 2) - 1 && " · "}</a>
              ))}
            </div>
            <h3 class="card-title">
              <a href={`/${a.data.postSlug}/`}>{a.data.title}</a>
            </h3>
            <div class="card-meta">
              {new Date(a.data.date).toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}
            </div>
            {a.data.excerpt && <p class="card-excerpt">{a.data.excerpt.slice(0, 100)}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .three-col-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .card-img-link { display: block; overflow: hidden; }
  .card-image { height: 220px; width: 100%; object-fit: cover; transition: transform 0.3s; }
  .card:hover .card-image { transform: scale(1.03); }

  @media (max-width: 900px) {
    .three-col-grid { grid-template-columns: repeat(2, 1fr); }
    .card-image { height: 200px; }
  }
  @media (max-width: 600px) {
    .three-col-grid { grid-template-columns: 1fr; }
    .hero-card img { height: 280px; }
  }
</style>
