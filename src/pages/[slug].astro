---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles
    .filter((a) => a.data.urlPath && !a.data.urlPath.startsWith("/page"))
    .map((a) => ({
      params: { slug: a.data.postSlug },
      props: { article: a },
    }));
}

const { article } = Astro.props;
const { title, date, categories, categorySlugs, image, excerpt } = article.data;
const { body } = article;
---

<Layout title={title} description={excerpt} image={image}>
  <article class="article-single">
    {image && <img src={image} alt={title} class="article-featured-image" style="width:100%;max-height:450px;object-fit:cover;border-radius:6px;margin-bottom:32px" />}
    <h1>{title}</h1>
    <div class="article-meta">
      <time datetime={date}>
        {new Date(date).toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}
      </time>
      {categories.length > 0 && <span> &middot; </span>}
      {categories.map((cat: string, i: number) => (
        <span><a href={`/category/${categorySlugs[i] || cat}/`} class="card-category">{cat}</a>{i < categories.length - 1 && ", "}</span>
      ))}
    </div>
    <div class="article-content" set:html={body} />
  </article>
</Layout>
